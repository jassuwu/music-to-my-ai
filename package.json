{
  "name": "music-to-my-ai",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "dev": "bun --watch scripts/build.ts",
